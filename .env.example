# Copiez ce fichier en ".env" (à la racine du projet, à côté de docker-compose.yml)
# et remplissez les valeurs réelles. Le fichier ".env" ne doit JAMAIS être commité
# (voir .gitignore).

# -- JWT ---------------------------------------------------------------
# Générez une valeur aléatoire forte, par ex. : openssl rand -base64 48
JWT_SECRET=changez_moi_avec_une_vraie_valeur_aleatoire_longue

# -- CORS ----------------------------------------------------------------
# Domaine(s) du frontend autorisé(s) à appeler l'API, séparés par des virgules.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# -- SMTP (envoi du code de vérification par e-mail) ---------------------
# Exemple avec Gmail : créez un "mot de passe d'application" sur
# https://myaccount.google.com/apppasswords (nécessite la validation en 2
# étapes activée sur le compte Google). N'utilisez jamais le mot de passe
# principal du compte ici.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=votre-adresse@gmail.com
SMTP_PASSWORD=votre_mot_de_passe_dapplication_16_caracteres
# En local sans SMTP configuré, le code peut être affiché dans les logs du
# serveur pour ne pas bloquer les tests manuels. À METTRE A "false" EN PRODUCTION.
MAIL_LOG_CODE_FALLBACK=true

# -- Google Sign-In --------------------------------------------------------
# Client ID OAuth 2.0 créé sur https://console.cloud.google.com/apis/credentials
# (type "ID client OAuth" > "Application Web"), avec http://localhost:4200 et
# votre domaine de production ajoutés comme "Origines JavaScript autorisées".
GOOGLE_CLIENT_ID=votre-client-id.apps.googleusercontent.com
